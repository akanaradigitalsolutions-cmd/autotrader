# Telegram (get API_ID / API_HASH from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=autotrader
# Username (@channel) or numeric chat id of the signal channel you're subscribed to
TELEGRAM_CHANNEL=

# MetaApi.cloud (https://metaapi.cloud) - hosted MT5 connection, no Windows terminal needed
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# Trading
SYMBOL=XAUUSD
LOT_SIZE=0.01
MAX_LOT_SIZE=1.0
# How many separate trades to open per signal (one per TP level, same entry/SL).
# e.g. 2 = trade 1 uses TP1, trade 2 uses TP2. Capped at however many TPs the signal has.
TRADES_PER_SIGNAL=2

# Safety - keep true until you've validated parsing against real signals
DRY_RUN=true
MAX_OPEN_POSITIONS=3

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/autotrader.log
