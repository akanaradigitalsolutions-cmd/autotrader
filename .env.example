# Telegram (get API_ID / API_HASH from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=autotrader
# Username (@channel) or numeric chat id of the signal channel you're subscribed to.
# For multiple channels, separate with commas: -1001422815541,@othersignals
TELEGRAM_CHANNEL=

# Broker backend: "metaapi" (hosted cloud, any OS) or "mt5local" (MT5
# terminal running on this same Windows machine - no cloud middleman).
BROKER_BACKEND=metaapi

# MetaApi.cloud (https://metaapi.cloud) - hosted MT5 connection, no Windows terminal needed
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# mt5local backend (Windows only). Leave MT5_LOGIN=0 to attach to whatever
# account the running MT5 terminal is already logged into.
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# Trading
SYMBOL=XAUUSD
# Exact symbol name your MT5 broker uses for orders/price lookups, if it
# differs from SYMBOL above (e.g. "XAUUSDm" on micro/cent accounts).
# Leave blank to default to SYMBOL.
BROKER_SYMBOL=
LOT_SIZE=0.01
MAX_LOT_SIZE=1.0
# How many separate trades to open per signal (one per TP level, same entry/SL).
# e.g. 2 = trade 1 uses TP1, trade 2 uses TP2. Capped at however many TPs the signal has.
TRADES_PER_SIGNAL=2

# Safety - keep true until you've validated parsing against real signals
DRY_RUN=true
MAX_OPEN_POSITIONS=3
# Refuse to trade signals where no stop loss could be parsed (recommended)
REQUIRE_STOP_LOSS=true
# Don't re-trade a signal with identical levels reposted within this many
# minutes (channels repost signals as reminders). 0 disables.
DUPLICATE_SIGNAL_WINDOW_MINUTES=120
# Never hold a BUY and a SELL on the same symbol at once (avoids being
# whipsawed by channels that disagree). Skips the conflicting signal.
PREVENT_OPPOSITE_POSITIONS=true
# After TP1 hits, move the remaining position(s) stop loss to entry so a
# banked winner can't reverse into a loss.
BREAKEVEN_AFTER_TP1=true
# Stop opening new trades after this % daily realized loss (0 disables).
DAILY_LOSS_LIMIT_PERCENT=5.0
# Honour channel cancellations ("don't trade it", "cancel", "no trade"):
# skip a not-yet-opened signal and close any position already opened for
# the cancelled signal (matched by its price levels).
HONOR_CANCELLATIONS=true
# Trailing stop / profit lock. Once a trade is +TRAILING_ACTIVATE_PIPS in
# profit, trail its stop TRAILING_DISTANCE_PIPS behind the best price.
# 1 gold pip = $0.10. Set TRAILING_ACTIVATE_PIPS=0 to disable.
TRAILING_ACTIVATE_PIPS=50
TRAILING_DISTANCE_PIPS=15
# Hard filter: skip signals whose reward:risk (TP1 vs stop) is below this.
# 0 disables. 1.0 means "don't trade signals where TP1 is closer than the stop".
SKIP_REWARD_RISK_BELOW=1.0
# Trend filter: "off", "shadow" (log what it would skip, still trades), or
# "on" (skip signals against the EMA trend). Start with "shadow" to measure.
TREND_FILTER=shadow
TREND_EMA_PERIOD=50
TREND_TIMEFRAME=H1
# Cancel a pending (limit) order that hasn't filled within this many minutes,
# so a stale signal can't fill late into a reversed market. 0 = never expire.
PENDING_ORDER_EXPIRY_MINUTES=120
# If a signal has no stop loss, apply a synthetic one this many pips from
# entry so it can be traded safely. 0 = keep refusing no-SL signals.
FALLBACK_STOP_LOSS_PIPS=0
# Enter at market immediately when a signal fires, even if price is outside
# the entry zone, instead of placing a pending limit order. true|false.
IMMEDIATE_ENTRY=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/autotrader.log
